{
  "name": "presupuesto-obra-cali-backend",
  "version": "1.0.0",
  "description": "API del presupuesto de obra: APU, intérprete de texto (IA con Gemini y reglas con Naive Bayes), cálculos y obras guardadas.",
  "private": true,
  "type": "module",
  "main": "src/servidor.js",
  "scripts": {
    "start": "node src/servidor.js",
