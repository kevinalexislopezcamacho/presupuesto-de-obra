# Variables de entorno del backend (todas opcionales).
# Copia este archivo como .env (en esta misma carpeta) y cambia lo que necesites: el servidor lo lee al arrancar.

# Puerto del servidor
PUERTO=3000

# Archivo donde se guardan las obras terminadas
ARCHIVO_OBRAS=./almacenamiento/obras.json

# Carpeta del frontend que se sirve en "/" (vacío para no servirlo y usar solo la API)
CARPETA_FRONTEND=../public

# Origen permitido para llamar la API desde otro dominio (por ejemplo, http://localhost:5173)
ORIGEN_PERMITIDO=

# "no" para no mostrar cada petición en la consola
REGISTRAR_PETICIONES=si

# --- IA (Gemini) para entender lo que escribe la persona ---
# Clave gratuita en https://aistudio.google.com/apikey (empieza por "AIza"). Sin clave, se usa solo el intérprete por reglas.
# Las claves que empiezan por "AQ." también suelen servir en AI Studio; si no, se prueba Vertex AI (pide facturación en Google Cloud).
# Para revisar que funcione: npm run ia:probar
# La clave queda en el servidor: nunca se envía al navegador. No subas el archivo .env a ningún repositorio.
GEMINI_API_KEY=
# Modelo de Gemini (https://ai.google.dev/gemini-api/docs/models). Flash-Lite responde en unos 2 s; Flash es más lento y a veces está saturado
GEMINI_MODELO=gemini-3.5-flash-lite
# Modelos que se prueban, en orden, si el principal está saturado o sin cuota (separados por comas)
GEMINI_MODELOS_RESPALDO=gemini-3.8-flash,gemini-3.5-flash,gemini-3.6-flash
# "auto" prueba AI Studio (gratis, sin facturación) y después Vertex AI, y usa el que responda; también "aistudio" o "vertex"
GEMINI_PROVEEDOR=auto
# Tiempo máximo en total, contando los modelos de respaldo (en milisegundos); después se usa el intérprete por reglas
IA_TIEMPO_MAXIMO_MS=25000
